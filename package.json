{
  "name": "claude-mods-for-codex",
  "version": "0.2.0-dev.7",
  "private": true,
  "description": "Reviewable local Codex hooks, scoped activity, and read-only project tools.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "codex-mods": "./bin/codex-mods.mjs"
  },
  "files": [
    ".codex-plugin/plugin.json",
    "bin/",
    "src/",
    "config/",
    "hooks/",
    "skills/",
    "examples/",
    "fixtures/",
    "test/",
    "docs/",
    "proofs/",
    "SECURITY.md",
    "CONTRIBUTING.md",
    ".mcp.json",
    "ui/"
  ],
  "scripts": {
    "test": "node --test",
    "validate": "node ./bin/codex-mods.mjs validate",
    "replay": "node ./bin/codex-mods.mjs replay --fixtures ./fixtures"
  },
  "license": "MIT"
}
